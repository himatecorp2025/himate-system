HIMATE_ENV=development
HIMATE_APP_VERSION=0.3.0-start-09-13
HIMATE_SESSION_SECRET=replace-with-at-least-32-random-characters
HIMATE_SESSION_TTL_HOURS=8
HIMATE_MFA_REQUIRED=false
COOKIE_SECURE=false
HIMATE_BOOTSTRAP_ADMIN_NAME=HIMATE Administrator
HIMATE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HIMATE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
HIMATE_INTERNAL_TOKEN=replace-with-a-random-service-token
HIMATE_SERVICE_CALLER_ID=gateway
HIMATE_REQUIRE_SERVICE_SIGNATURE=false
DATABASE_URL=postgres://himate:password@localhost:5432/himate?sslmode=disable
PARTNERS_HOSTPORT=localhost:10001
CATALOG_HOSTPORT=localhost:10002
BILLING_HOSTPORT=localhost:10003
TENANT_FINANCE_HOSTPORT=localhost:10015
AUTOMATION_HOSTPORT=localhost:10016
CONTACT_HOSTPORT=localhost:10004
PROVISIONING_HOSTPORT=localhost:10005
ENVIRONMENTS_HOSTPORT=localhost:10006
CONNECTOR_HOSTPORT=localhost:10007
HEALTH_HOSTPORT=localhost:10008
IMPACT_HOSTPORT=localhost:10009
EVIDENCE_HOSTPORT=localhost:10012
REPORTS_HOSTPORT=localhost:10013
STORAGE_HOSTPORT=localhost:10010
PARTNER_RUNTIME_HOSTPORT=localhost:10011
HIMATE_STORAGE_ROOT=/data/partners

# START-09 provisioning requires an administrative PostgreSQL connection able
# to create isolated partner databases/roles. Use a dedicated privileged
# credential in production; never reuse an application-role password.
PARTNER_DATABASE_ADMIN_URL=
PARTNER_DATABASE_MASTER_SECRET=replace-with-at-least-32-random-characters

# Optional Contact notification delivery. Inquiries are still persisted when
# SMTP is not configured; set these values to enable email notification.
HIMATE_CONTACT_NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CMS_HOSTPORT=localhost:10014

# Tenant/customer operational invoicing. These are platform defaults only;
# each partner can override them through its own Finance policy.
HIMATE_TENANT_FINANCE_DEFAULT_TERMS_DAYS=8
HIMATE_TENANT_FINANCE_DEFAULT_ACCOUNTING_BASIS=CASH
HIMATE_TENANT_FINANCE_DEFAULT_PAYMENT_METHODS=
HIMATE_TENANT_FINANCE_DEFAULT_CURRENCY=USD
HIMATE_TENANT_FINANCE_DEFAULT_INVOICE_PREFIX=INV
HIMATE_AUTOMATION_SERVICE_KEYS_JSON={"finance":"replace-with-a-dedicated-finance-automation-secret","workshop":"replace-with-a-dedicated-workshop-automation-secret","scheduler":"replace-with-a-dedicated-scheduler-automation-secret"}
HIMATE_AUTOMATION_FINANCE_SECRET=replace-with-a-dedicated-finance-automation-secret
