HIMATE_ENV=development
HIMATE_APP_VERSION=0.2.0-start-04-08
HIMATE_SESSION_SECRET=replace-with-at-least-32-random-characters
HIMATE_SESSION_TTL_HOURS=8
COOKIE_SECURE=false
HIMATE_BOOTSTRAP_ADMIN_NAME=HIMATE Administrator
HIMATE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HIMATE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
HIMATE_INTERNAL_TOKEN=replace-with-a-random-service-token
DATABASE_URL=postgres://himate:password@localhost:5432/himate?sslmode=disable
PARTNERS_HOSTPORT=localhost:10001
CATALOG_HOSTPORT=localhost:10002
BILLING_HOSTPORT=localhost:10003
