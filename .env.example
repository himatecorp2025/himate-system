PORT=10000
HIMATE_ENV=development
HIMATE_APP_VERSION=0.1.0-start-01-03
HIMATE_SESSION_SECRET=replace-with-at-least-32-random-characters
HIMATE_SESSION_TTL_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
HIMATE_BOOTSTRAP_ADMIN_NAME=HIMATE Administrator
HIMATE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
HIMATE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Optional future PostgreSQL connection. START-01/03 ships the migration contract,
# while the runtime store remains bootstrap-memory until the DB adapter step.
DATABASE_URL=
